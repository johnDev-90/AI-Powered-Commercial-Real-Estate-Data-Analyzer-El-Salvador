# PostgreSQL connection used by the app at runtime (pooled URL is fine).
# Local options:
#   - Docker:   docker compose up -d   -> postgresql://postgres:postgres@localhost:5432/cre_analyzer
#   - Embedded: npm run db:local       -> postgresql://postgres:postgres@127.0.0.1:5433/postgres
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/cre_analyzer"

# Optional: direct (non-pooled) URL used by `prisma migrate deploy`.
# Neon on Vercel sets DATABASE_URL_UNPOOLED automatically.
# DATABASE_URL_UNPOOLED=""

# Optional: max connections in the pg pool (default 5; use 1 with the embedded PGlite server).
# DATABASE_POOL_MAX="5"

# OpenAI — server-side only. Without a key, AI features show "not configured" and everything else works.
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-5.4-mini"
# OPENAI_TIMEOUT_MS="45000"
